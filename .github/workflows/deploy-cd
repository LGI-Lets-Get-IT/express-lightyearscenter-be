name: Deploy application
on: push

jobs:
  deploy-to-development:
    runs-on: ubuntu-latest
    steps:
    - name: Deploy to SSH
      run: |
        ssh -o StrictHostKeyChecking=no -i ${{ secrets.SSH_PRIVATE_KEY }} root@server.itslgit.com "
        docker container rm -f lumecafe_backend || true && 
        docker image rm -f mrizalrizky/lume-pos-backend:latest || true &&
        docker run --name lumcafe_backend -d -p 3443:3443"
    
